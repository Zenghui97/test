npts 46 50 46                        # num.grid points in xyz
gridfld CASP9.maps.fld               # grid_data_file
spacing 0.375                        # spacing(A)
receptor_types A C H HD N OA SA      # receptor atom types
ligand_types A C HD N NA OA SA       # ligand atom types
receptor CASP9.pdbqt                 # macromolecule
gridcenter 21.0 42.0 -14.0           # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map CASP9.A.map                      # atom-specific affinity map
map CASP9.C.map                      # atom-specific affinity map
map CASP9.HD.map                     # atom-specific affinity map
map CASP9.N.map                      # atom-specific affinity map
map CASP9.NA.map                     # atom-specific affinity map
map CASP9.OA.map                     # atom-specific affinity map
map CASP9.SA.map                     # atom-specific affinity map
elecmap CASP9.e.map                  # electrostatic potential map
dsolvmap CASP9.d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant
